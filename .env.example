# Орчны хувьсагчийн жишээ. Утгагүй — .env.local руу хуулж бөглөнө.
# NEXT_PUBLIC_* нь build / dev server асах үед inline болдог: өөрчилсний дараа дахин асаана.

# Backend (proxy app/api/[...path] үүн рүү дамжуулна), жишээ нь staging service.
NEXT_PUBLIC_API_URL=

# Шинжилгээнд оролцох нийтийн холбоосын суурь URL.
NEXT_PUBLIC_SURVEY_PARTICIPATE_URL=

# Талентийн үнэлгээ — бичих хүсэлтийн хамгаалалт (DRY-RUN).
# Хоосон эсвэл "1"-ээс өөр үед үүсгэх, хадгалах, нийтлэх, урих, сунгах, үнэлгээ,
# тэмдэглэл, bookmark, лого, хаах, устгах, нэр солих хүсэлт сүлжээнд ГАРАХГҮЙ:
# console-д маскалсан log бичиж, stub хариу буцаана, хуудсанд DRY-RUN banner гарна.
# Зөвхөн "1" үед бодит бичилт хийгдэнэ (жинхэнэ имэйл илгээгдэж болно).
NEXT_PUBLIC_RA_ALLOW_WRITES=
